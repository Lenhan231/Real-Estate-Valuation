# Build stage
FROM python:3.11-slim as builder

WORKDIR /app

# Install minimal dependencies for Streamlit (no backend API, no ML training, no scraping)
COPY requirements-streamlit.txt ./
RUN pip install --no-cache-dir -r requirements-streamlit.txt

# Runtime stage
FROM python:3.11-slim

WORKDIR /app

# Install system dependencies required by LightGBM
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    libopenblas-dev \
    && rm -rf /var/lib/apt/lists/*

# Install runtime dependencies only
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages

# Copy application code
COPY . .

# Create Streamlit config directory and add headless configuration
RUN mkdir -p /root/.streamlit
COPY .streamlit/config.toml /root/.streamlit/config.toml

# Expose Streamlit port
EXPOSE 8501

# Run Streamlit (use environment variables from Render config)
CMD ["streamlit", "run", "app/ui/streamlit_app.py"]